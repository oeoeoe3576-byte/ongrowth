 "headlines": [
  {
   "line1": "글만 썼는데",
   "line2": "밥이 공짜라고요?",
   "from": 0,
   "to": 4.89
  },
  {
   "line1": "체험단 시작은",
   "line2": "딱 3단계",
   "from": 4.89,
   "to": 19.02
  },
  {
   "line1": "다음 편",
   "line2": "글로 돈 버는 법",
   "from": 19.02,
   "to": 21.79
  }
 ],
 "captions": [
  {
   "from": 0.2,
   "to": 1.9,
   "text": "글 쓰는데, 생활비가 아껴지고"
  },
  {
   "from": 1.9,
   "to": 3.3,
   "text": "밥도 공짜라고요?"
  },
  {
   "from": 3.3,
   "to": 4.8,
   "text": "체험단 이야기예요."
  },
  {
   "from": 4.89,
   "to": 6.64,
   "text": "식당이나 제품을 제공받고,"
  },
  {
   "from": 6.64,
   "to": 8.53,
   "text": "후기를 블로그에 쓰는 거예요."
  },
  {
   "from": 8.53,
   "to": 9.84,
   "text": "시작은 세 단계예요."
  },
  {
   "from": 9.84,
   "to": 12.03,
   "text": "하나, 체험단 사이트에 가입해요."
  },
  {
   "from": 12.03,
   "to": 14.65,
   "text": "둘, 내 블로그 주제에 맞는 곳에 신청해요."
  },
  {
   "from": 14.65,
   "to": 17.42,
   "text": "셋, 후기엔 제공받았다는 문구를 꼭 적어요."
  },
  {
   "from": 17.42,
   "to": 19.02,
   "text": "빼면 안 되는 규칙이에요."
  },
  {
   "from": 19.02,
   "to": 20.77,
   "text": "다음에는 글로 돈 버는 방법을"
  },
  {
   "from": 20.77,
   "to": 21.79,
   "text": "알려드릴게요."
  }
 ]
}