    "start:server": "tsx src/server/index.ts",
    "scheduler": "tsx src/scheduler/run.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/test/run-all.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "js-yaml": "^4.1.0",
    "luxon": "^3.5.0",
    "node-cron": "^3.0.3",
    "playwright": "^1.48.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/luxon": "^3.7.5",
    "@types/node": "^20.14.15",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
