# === Claude / Anthropic (콘텐츠 문구, 캡션 다듬기용. 없으면 규칙 기반 폴백 사용) ===
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# === Instagram (Meta Graph API - Content Publishing) ===
# instagram.enabled=false 인 동안은 아래 값이 없어도 전체 파이프라인이 정상 동작한다.
INSTAGRAM_ACCOUNT_ID=
META_ACCESS_TOKEN=
# Graph API 버전은 구현 시점 최신 안정 버전으로 확인 후 채울 것 (예: v21.0)
META_GRAPH_API_VERSION=

# === 실행 모드 ===
# true면 실제 SNS 업로드를 절대 하지 않고 "이 시간에 업로드될 예정"이라는 로그만 남긴다.
DRY_RUN=true
# true(기본): 생성 → 저장 후 사람이 승인해야 예약/발행으로 넘어간다.
# false: 생성 → 예약 → 자동 업로드까지 승인 없이 진행한다.
REVIEW_MODE=true

# === 관리 대시보드 서버 ===
PORT=4000
