{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowJs": false
  },
  "include": ["src", "dashboard/server.ts"],
  "exclude": ["node_modules", "dist", "cardnews_output", "publish_inbox", "publish_scheduled", "publish_success", "publish_failed"]
}
